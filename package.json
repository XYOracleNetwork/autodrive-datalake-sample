{
  "name": "@xyo-network/autodrive-datalake-sample",
  "private": true,
  "description": "Node CLI sample: store a message in Auto Drive and anchor it on XL1 using the Aries CLI wallet",
  "homepage": "https://github.com/XYOracleNetwork/autodrive-datalake-sample",
  "bugs": {
    "url": "https://github.com/XYOracleNetwork/autodrive-datalake-sample/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/XYOracleNetwork/autodrive-datalake-sample.git"
  },
  "license": "MIT",
  "author": {
    "name": "XYO Network",
    "url": "https://xyo.network"
  },
  "type": "module",
  "scripts": {
    "build": "xy build --strict --no-defer",
    "check": "xy check --strict --no-defer",
    "compile": "xy compile --no-defer --no-incremental",
    "lint": "xy lint --strict --no-defer",
    "start": "pnpm compile && node dist/node/cli.mjs",
    "test": "xy test --no-defer",
    "test:sample": "pnpm compile && vitest run --project local-xl1",
    "test:live": "pnpm compile && vitest run --config vitest.live.config.ts --project local-xl1",
    "sample-cli": "node dist/node/cli.mjs"
  },
  "devDependencies": {
    "@ariestools/cli": "~0.1.20",
    "@ariestools/eslint-config-flat": "~10.0.5",
    "@ariestools/toolchain": "~10.0.5",
    "@ariestools/tsconfig": "~10.0.5",
    "@ariestools/vitest-config": "~10.0.5",
    "@aws-sdk/client-s3": "~3.1128.0",
    "@types/node": "~26.5.0",
    "@xyo-network/dapp-kit-vitest-config": "~2.0.0",
    "eslint": "~10.10.0",
    "eslint-import-resolver-typescript": "~4.4.5",
    "typescript": "~6.0.3",
    "vite": "~8.2.2",
    "vitest": "~5.0.0"
  },
  "packageManager": "pnpm@12.3.4",
  "volta": {
    "node": "24.14.1"
  },
  "version": "0.1.0",
  "bin": {
    "sample-cli": "dist/node/cli.mjs"
  },
