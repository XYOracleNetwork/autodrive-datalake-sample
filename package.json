    "@xyo-network/archivist-s3": "~7.4.1",
    "@xyo-network/dapp-kit": "~2.0.0",
    "@xyo-network/sdk": "~7.4.1",
    "@xyo-network/sdk-protocol": "~7.4.2",
    "@xyo-network/xl1-sdk": "~5.5.3",
    "async-mutex": "~0.5.0",
    "ethers": "~6.17.0",
    "zod": "~4.5.4"
  }
}
