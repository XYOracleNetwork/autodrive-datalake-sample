# Copy to .env. Run from the repository root with Node 24 and the pinned pnpm.
# XL1 settings are selected by start:local, start:sequence, or start:mainnet.
SAMPLE_ORIGIN=http://127.0.0.1:5173
SAMPLE_AUDIENCE=autodrive-sample
# Base directory; each startup profile keeps its own ledger here.
SAMPLE_STATE_DIR=.sample/state

# Local: set only this storage credential; leave all three ARIES_* settings blank.
# The server uses the published XYO Auto Drive adapter with fixed endpoint/namespace.
# Never prefix this key with VITE_ or put it in browser code.
AUTODRIVE_API_KEY=

# Sequence/Mainnet: required connection to an existing Aries Auto Drive plane.
# Local: optional override, but supply all three together if using an Aries plane.
ARIES_PLANE_URL=
ARIES_DATALAKE_ID=
ARIES_PLANE_TOKEN=

# Writes remain explicit and bounded, including in local mode with real Auto Drive.
# Comma-separated lowercase XYO signer addresses. No private keys or mnemonic.
SAMPLE_WRITE_ENABLED=false
SAMPLE_ALLOWED_SIGNERS=
SAMPLE_ACCOUNT_DAILY_WRITES=2
SAMPLE_ACCOUNT_DAILY_BYTES=8192
SAMPLE_GLOBAL_DAILY_WRITES=5
SAMPLE_GLOBAL_DAILY_BYTES=20480
